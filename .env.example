# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
GEMINI_API_KEY=...                      # https://aistudio.google.com/apikey

# --- optional ---
# Only these Telegram user ids may use the bot (comma separated).
# Empty = the first person who writes to the bot becomes the owner.
ALLOWED_USER_IDS=
TIMEZONE=Asia/Tashkent
# Tried in order; the next one is used when a model is rate-limited / down.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
BRAIN_DIR=brain
# auto commit/push/pull ./brain if it is a git repo
BRAIN_GIT_SYNC=true
# daily morning summary (empty = off)
DIGEST_TIME=08:00

# --- user-agent: phones you with spoken reminders (optional) ---
# api_id / api_hash from https://my.telegram.org ; link the account from the bot menu: /agent
TG_API_ID=
TG_API_HASH=
AGENT_PHONE=+1234567890
# Call voice (Gemini TTS). Youthful female: Leda; others: Aoede, Kore, Zephyr, Autonoe, Callirrhoe.
TTS_VOICE=Leda
# How Marin names you when she contacts other people (empty = "Ismi:" line of brain/profile.md)
OWNER_NAME=
